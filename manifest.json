{
  "manifest_version": 3,
  "name": "Playbook",
  "version": "1.2",
  "key": "",
  "description": "Floating sidebar to build, organize, and export interview prep notes with full rich-text formatting.",
  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "oauth2": {
    "client_id": "539583220061-4goq43dqh1lg4ro6hi377e4396de9tvg.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "action": {
    "default_title": "Open Playbook"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "sidebar.css",
        "sidebar.js",
        "drive-sync.js",
        "lib/Sortable.min.js",
        "lib/html2pdf.bundle.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
